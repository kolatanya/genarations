# Copy this file to .env and fill in keys from your Alpaca PAPER trading dashboard.
# .env is git-ignored. Never commit real keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional overrides
# EXECUTION_MODE=yfinance      # yfinance (menu defaults to Mode 1) | alpaca (menu defaults to Mode 2)
# LIVE_DATA_SOURCE=yfinance    # where live signals get daily bars: yfinance | alpaca
